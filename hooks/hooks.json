{
  "description": "Greets the user once per install and once per minor/major version; silent otherwise.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/greet.sh\"", "timeout": 5 }
        ]
      }
    ]
  }
}
